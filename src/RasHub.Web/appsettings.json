{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "RasHub"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ]
  },
  "Seq": {
    "UiUrl": "http://localhost:5341"
  },
  "Synchronization": {
    "InteractiveQueueCapacity": 256,
    "QueueCapacity": 1024,
    "MaintenanceQueueCapacity": 256,
    "InteractiveWorkerCount": 8,
    "WorkerCount": 16,
    "MaintenanceWorkerCount": 2,
    "PriorityFairnessInterval": 16,
    "CompletedTaskRetention": "00:10:00",
    "RegistryCleanupInterval": "00:01:00",
    "MaxTrackedTasks": 10000
  },
  "Settings": {
    "InitializeOnStart": true
  },
  "AllowedHosts": "*"
}
