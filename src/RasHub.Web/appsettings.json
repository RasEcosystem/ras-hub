{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "RasHub"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ]
  },
  "DataProtection": {
    "ApplicationName": "RasHub"
  },
  "BackgroundTasks": {
    "InteractiveQueueCapacity": 256,
    "SynchronizationQueueCapacity": 1024,
    "MaintenanceQueueCapacity": 256,
    "InteractiveWorkerCount": 8,
    "SynchronizationWorkerCount": 16,
    "MaintenanceWorkerCount": 2,
    "CompletedTaskRetention": "00:10:00",
    "RegistryCleanupInterval": "00:01:00",
    "MaxActiveTasks": 10000,
    "MaxCompletedTaskHistory": 1000
  },
  "RasGateMonitoring": {
    "RunOnStartup": true,
    "PollInterval": "00:01:00",
    "OnlineThreshold": "00:03:00",
    "RequestTimeout": "00:00:10"
  },
  "Settings": {
    "InitializeOnStart": true
  },
  "AllowedHosts": "*"
}
