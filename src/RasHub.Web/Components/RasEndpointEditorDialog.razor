@using RasHub.Application.RasEndpoints.Exceptions
@using RasHub.Application.RasEndpoints.Models
@using RasHub.Domain
@using RasHub.Infrastructure.Database.Queries
@using RasHub.Web.Infrastructure.RasEndpoints
<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" ValidationDelay="0">
            <MudStack Spacing="3">
                @if (GateOptions.Count == 0)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense>
                        Register a RasGate before adding a RAS endpoint.
                    </MudAlert>
                }

                <MudTextField T="string"
                              @bind-Value="_name"
                              Label="Name"
                              Variant="Variant.Outlined"
                              Required
                              RequiredError="Name is required"
                              MaxLength="@RasEndpoint.NameMaxLength"
                              Counter="@RasEndpoint.NameMaxLength"
                              Immediate/>

                <MudSelect T="Guid"
                           @bind-Value="_rasGateId"
                           Label="RasGate"
                           Variant="Variant.Outlined"
                           Required
                           RequiredError="Select a RasGate">
                    @foreach (var gate in GateOptions)
                    {
                        <MudSelectItem T="Guid" Value="@gate.Id">
                            @gate.Name · @FormatGateEndpoint(gate)@(!gate.IsActive ? " · inactive" : null)
                        </MudSelectItem>
                    }
                </MudSelect>

                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="8">
                        <MudTextField T="string"
                                      @bind-Value="_host"
                                      Label="RAS host"
                                      Placeholder="ras.example.net"
                                      Variant="Variant.Outlined"
                                      Required
                                      RequiredError="RAS host is required"
                                      MaxLength="@RasEndpoint.HostMaxLength"
                                      Validation="@(new Func<string?, string?>(ValidateHost))"
                                      Immediate/>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudNumericField T="int"
                                         @bind-Value="_port"
                                         Label="RAS port"
                                         Variant="Variant.Outlined"
                                         Min="1"
                                         Max="65535"
                                         Required/>
                    </MudItem>
                </MudGrid>

                <MudSwitch T="bool"
                           @bind-Value="_isActive"
                           Color="Color.Primary"
                           Label="Active"/>
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudStack Row
                  Justify="Justify.FlexEnd"
                  Spacing="2"
                  Class="px-4 pb-4"
                  Style="width: 100%;">
            <MudButton OnClick="Cancel">Cancel</MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Outlined.Save"
                       Disabled="@(GateOptions.Count == 0)"
                       OnClick="SaveAsync">
                @(Endpoint is null ? "Add" : "Save changes")
            </MudButton>
        </MudStack>
    </DialogActions>
</MudDialog>

@code {
    private MudForm _form = null!;
    private string _name = string.Empty;
    private Guid _rasGateId;
    private string _host = "localhost";
    private int _port = 1545;
    private bool _isActive = true;

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public RasEndpointAdministrationItem? Endpoint { get; set; }

    [Parameter][EditorRequired] public IReadOnlyList<RasEndpointGateOption> GateOptions { get; set; } = [];

    protected override void OnInitialized()
    {
        if (Endpoint is null)
        {
            _rasGateId = GateOptions.FirstOrDefault(gate => gate.IsActive)?.Id ??
                         GateOptions.FirstOrDefault()?.Id ??
                         Guid.Empty;
            return;
        }

        _name = Endpoint.Name;
        _rasGateId = GateOptions.Any(gate => gate.Id == Endpoint.RasGateId)
            ? Endpoint.RasGateId
            : Guid.Empty;
        _host = Endpoint.Host;
        _port = Endpoint.Port;
        _isActive = Endpoint.IsActive;
    }

    private string? ValidateHost(string? value)
    {
        try
        {
            _ = RasEndpointAddress.Create(value ?? string.Empty, _port);
            return null;
        }
        catch (RasEndpointAddressValidationException)
        {
            return "Enter a valid DNS name or IP address";
        }
    }

    private async Task SaveAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid || _rasGateId == Guid.Empty)
            return;

        MudDialog.Close(DialogResult.Ok(new RasEndpointEditorValues(
            _name,
            _rasGateId,
            _host,
            _port,
            _isActive)));
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private static string FormatGateEndpoint(RasEndpointGateOption gate)
    {
        if (!Uri.TryCreate(gate.Url, UriKind.Absolute, out var address))
            return $"{gate.Url} · port {gate.Port}";

        return new UriBuilder(address) { Port = gate.Port }
            .Uri
            .ToString()
            .TrimEnd('/');
    }

}
