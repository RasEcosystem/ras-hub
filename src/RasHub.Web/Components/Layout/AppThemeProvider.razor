@using RasHub.Web.Infrastructure.Themes.Providers
@implements IAsyncDisposable
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IUserSettingsProvider UserSettingsProvider
@inject ISettingsProvider<ApplicationSettings> ApplicationSettingsProvider
@inject IJSRuntime JSRuntime

<MudThemeProvider Theme="@_theme" IsDarkMode="@_isDarkMode"/>

@if (_followSystemTheme)
{
    <SystemThemeStyles/>
}

@code {
    private MudTheme _theme = new();
    private IJSObjectReference? _themeModule;
    private DotNetObjectReference<AppThemeProvider>? _dotNetReference;
    private bool _isDarkMode;
    private bool _systemDarkMode;
    private bool _followSystemTheme;
    private bool _isAuthenticated;
    private AppTheme? _userTheme;

    protected override async Task OnInitializedAsync()
    {
        ApplyTheme(ApplicationSettingsProvider.Settings.Theme);

        ApplicationSettingsProvider.SettingsChanged += OnApplicationSettingsChanged;
        UserSettingsProvider.SettingsChanged += OnUserSettingsChanged;
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;

        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        await ApplyThemeForAsync(authenticationState);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _themeModule = await JSRuntime.InvokeAsync<IJSObjectReference>(
            "import",
            "./Components/Layout/AppThemeProvider.razor.js");

        _systemDarkMode = await _themeModule.InvokeAsync<bool>("getSystemDarkMode");
        _dotNetReference = DotNetObjectReference.Create(this);

        await _themeModule.InvokeVoidAsync("watchSystemDarkMode", _dotNetReference);

        if (_followSystemTheme && _isDarkMode != _systemDarkMode)
        {
            _isDarkMode = _systemDarkMode;
            StateHasChanged();
        }
    }

    private async Task ApplyThemeForAsync(AuthenticationState authenticationState)
    {
        _isAuthenticated = authenticationState.User.Identity?.IsAuthenticated == true;

        if (_isAuthenticated)
        {
            var userSettings = await UserSettingsProvider.GetAsync();
            _userTheme = userSettings.Theme;
        }
        else
        {
            _userTheme = null;
        }

        ApplyEffectiveTheme();
    }

    private void ApplyEffectiveTheme()
    {
        var theme = _userTheme ?? ApplicationSettingsProvider.Settings.Theme;

        ApplyTheme(theme);
    }

    private void ApplyTheme(AppTheme theme)
    {
        var definition = ThemeProvider.GetTheme(theme);
        var lightDefinition = ThemeProvider.GetTheme(AppTheme.Light);

        var darkDefinition = theme == AppTheme.Slate
            ? definition
            : ThemeProvider.GetTheme(AppTheme.Carbon);

        _followSystemTheme = theme == AppTheme.System;
        _isDarkMode = _followSystemTheme
            ? _systemDarkMode
            : definition.MudTheme.IsDarkMode;

        _theme = new MudTheme
        {
            PaletteLight = (PaletteLight)lightDefinition.MudTheme.Palette,
            PaletteDark = (PaletteDark)darkDefinition.MudTheme.Palette,
            Shadows = _followSystemTheme
                ? lightDefinition.MudTheme.Shadows
                : definition.MudTheme.Shadows,
            Typography = definition.MudTheme.Typography
        };
    }

    [JSInvokable]
    public Task OnSystemDarkModeChanged(bool isDarkMode)
    {
        _systemDarkMode = isDarkMode;

        if (_followSystemTheme)
        {
            _isDarkMode = isDarkMode;
            return InvokeAsync(StateHasChanged);
        }

        return Task.CompletedTask;
    }

    private Task OnApplicationSettingsChanged(ApplicationSettings settings)
    {
        if (!_isAuthenticated || _userTheme is null)
        {
            ApplyTheme(settings.Theme);
            return InvokeAsync(StateHasChanged);
        }

        return Task.CompletedTask;
    }

    private void OnUserSettingsChanged(UserSettings settings)
    {
        if (!_isAuthenticated)
        {
            return;
        }

        _userTheme = settings.Theme;
        ApplyEffectiveTheme();
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnAuthenticationStateChanged(Task<AuthenticationState> authenticationStateTask)
    {
        _ = InvokeAsync(async () =>
        {
            var authenticationState = await authenticationStateTask;

            await ApplyThemeForAsync(authenticationState);
            StateHasChanged();
        });
    }

    public async ValueTask DisposeAsync()
    {
        ApplicationSettingsProvider.SettingsChanged -= OnApplicationSettingsChanged;
        UserSettingsProvider.SettingsChanged -= OnUserSettingsChanged;
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;

        if (_themeModule is not null)
        {
            try
            {
                await _themeModule.InvokeVoidAsync("stopWatchingSystemDarkMode");
                await _themeModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _dotNetReference?.Dispose();
    }

}
