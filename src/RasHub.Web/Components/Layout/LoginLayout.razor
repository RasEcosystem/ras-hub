@inherits LayoutComponentBase

<AppThemeProvider/>

<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<MudLayout>

    <MudAppBar Elevation="1">

        <MudStack Row
                  AlignItems="AlignItems.Center"
                  Spacing="2">

            <CosmicBrandMark/>

            <MudStack Row
                      Spacing="1"
                      AlignItems="AlignItems.Center">

                <MudText Typo="Typo.h6">
                    <a href="/" class="brand-home-link">RasHub</a>
                </MudText>

                <MudText Typo="Typo.overline"
                         Color="Color.Primary">
                    @SolutionVersion
                </MudText>

            </MudStack>

        </MudStack>

    </MudAppBar>

    <MudMainContent Class="pt-16">
        <AppPageShell Width="AppPageWidth.Narrow">
            @Body
        </AppPageShell>
    </MudMainContent>

</MudLayout>

<div id="blazor-error-ui"
     data-nosnippet>

    An unhandled error has occurred.

    <a href="."
       class="reload">
        Reload
    </a>

    <span class="dismiss">
        🗙
    </span>

</div>

@code {
    private const string SolutionVersion = ThisAssembly.AssemblyFileVersion;
}
