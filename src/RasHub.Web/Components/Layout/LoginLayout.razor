@inherits LayoutComponentBase

<AppThemeProvider/>

<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<MudLayout>

    <MudAppBar Elevation="1">

        <MudStack Row
                  AlignItems="AlignItems.Center"
                  Spacing="2">

            <CosmicBrandMark/>

            <MudStack Row
                      Spacing="1"
                      AlignItems="AlignItems.Center">

                <MudText Typo="Typo.h6">
                    RasHub
                </MudText>

                <MudText Typo="Typo.overline"
                         Color="Color.Primary">
                    @SolutionVersion
                </MudText>

            </MudStack>

        </MudStack>

    </MudAppBar>

    <MudMainContent Class="pt-16 pa-4">

        <MudContainer MaxWidth="MaxWidth.Small"
                      Class="py-8">

            @Body

        </MudContainer>

    </MudMainContent>

</MudLayout>

<div id="blazor-error-ui"
     data-nosnippet>

    An unhandled error has occurred.

    <a href="."
       class="reload">
        Reload
    </a>

    <span class="dismiss">
        🗙
    </span>

</div>

@code {
    private const string SolutionVersion = ThisAssembly.AssemblyFileVersion;
}
