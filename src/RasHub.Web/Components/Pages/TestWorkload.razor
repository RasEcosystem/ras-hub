@page "/test-workload"
@using RasHub.Synchronization.Abstractions
@using RasHub.Synchronization.Exceptions
@using RasHub.Synchronization.Models
@using RasHub.Synchronization.Tasks
@inject ISynchronizationEngine Engine
@inject ISnackbar Snackbar

<AppPageTitle Title="Test workload"/>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
    <MudStack Spacing="3">
        <div>
            <MudText Typo="Typo.h4">Test workload</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Enqueue synthetic tasks to exercise synchronization lanes interactively
            </MudText>
        </div>

        <MudPaper Class="pa-5" Elevation="1">
            <MudStack Spacing="3">
                <MudSelect T="BackgroundTaskQueue" @bind-Value="Lane" Label="Lane"
                           Variant="Variant.Outlined" Class="workload-lane">
                    @foreach (var lane in Enum.GetValues<BackgroundTaskQueue>())
                    {
                        <MudSelectItem T="BackgroundTaskQueue" Value="@lane">@lane</MudSelectItem>
                    }
                </MudSelect>

                <MudGrid Spacing="3">
                    <MudItem xs="12" sm="4">
                        <MudNumericField T="int" @bind-Value="TaskCount" Label="Number of tasks"
                                         Min="1" Max="1000" Variant="Variant.Outlined"/>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudNumericField T="double" @bind-Value="MinSeconds" Label="Minimum duration, sec"
                                         Min="0" Max="3600" Step="0.1" Variant="Variant.Outlined"/>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudNumericField T="double" @bind-Value="MaxSeconds" Label="Maximum duration, sec"
                                         Min="0" Max="3600" Step="0.1" Variant="Variant.Outlined"/>
                    </MudItem>
                </MudGrid>

                <MudStack Row Justify="Justify.FlexEnd">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Outlined.PlayArrow" OnClick="Enqueue">
                        Enqueue tasks
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>
    </MudStack>
</MudContainer>

@code {
    private BackgroundTaskQueue Lane { get; set; } = BackgroundTaskQueue.Synchronization;
    private int TaskCount { get; set; } = 10;
    private double MinSeconds { get; set; } = 1;
    private double MaxSeconds { get; set; } = 5;

    private void Enqueue()
    {
        var count = Math.Clamp(TaskCount, 1, 1000);
        var minSeconds = Math.Clamp(MinSeconds, 0, 3600);
        var maxSeconds = Math.Clamp(MaxSeconds, 0, 3600);

        if (minSeconds > maxSeconds)
        {
            Snackbar.Add("Minimum duration must not exceed maximum duration.", Severity.Warning);
            return;
        }

        var enqueued = 0;
        try
        {
            for (; enqueued < count; enqueued++)
            {
                var seconds = minSeconds == maxSeconds
                    ? minSeconds
                    : minSeconds + Random.Shared.NextDouble() * (maxSeconds - minSeconds);

                Engine.Enqueue(
                    new TestBackgroundTask(TimeSpan.FromSeconds(seconds)),
                    new BackgroundTaskOptions
                    {
                        Queue = Lane,
                        MaxAttempts = 1,
                        Timeout = TimeSpan.FromSeconds(Math.Max(seconds + 30, 30))
                    });
            }

            Snackbar.Add($"Enqueued {enqueued} test task(s) in {Lane}.", Severity.Success);
        }
        catch (BackgroundTaskRejectedException exception)
        {
            Snackbar.Add($"Enqueued {enqueued} of {count}: {exception.Message}", Severity.Warning);
        }
    }

}
