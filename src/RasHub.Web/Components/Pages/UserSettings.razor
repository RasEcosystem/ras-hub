@page "/user-settings"
@using RasHub.Web.Infrastructure
@attribute [Authorize]

@inject IUserSettingsProvider UserSettingsProvider
@inject UserApiKeyService UserApiKeyService

<AppPageTitle Title="User Settings"/>

<MudContainer MaxWidth="MaxWidth.False"
              Style="max-width: 1600px;"
              Class="py-8">

    <MudStack Spacing="6">

        <MudStack Spacing="1">
            <MudStack Row
                      AlignItems="AlignItems.Center"
                      Spacing="2">

                <MudIcon Icon="@Icons.Material.Filled.ManageAccounts"
                         Size="Size.Large"
                         Color="Color.Primary"/>

                <MudText Typo="Typo.h3">
                    User Settings
                </MudText>

            </MudStack>

            <MudText Typo="Typo.subtitle1"
                     Color="Color.Secondary">
                Configure your personal application preferences
            </MudText>
        </MudStack>

        <MudDivider/>

        <MudForm Model="_settings"
                 @ref="_form"
                 ValidationDelay="0">

            <MudGrid Spacing="3">

                <MudItem xs="12">
                    <MudPaper Class="pa-6"
                              Elevation="1">

                        <MudStack Spacing="4">

                            <MudStack Row
                                      AlignItems="AlignItems.Center"
                                      Spacing="1">

                                <MudIcon Icon="@Icons.Material.Outlined.Palette"
                                         Size="Size.Small"
                                         Color="Color.Primary"/>

                                <MudText Typo="Typo.h5">
                                    Appearance
                                </MudText>

                            </MudStack>

                            <MudSelect T="AppTheme?"
                                       Label="Theme"
                                       Variant="Variant.Outlined"
                                       FullWidth
                                       @bind-Value="_settings.Theme">

                                <MudSelectItem T="AppTheme?"
                                               Value="@((AppTheme?)null)">
                                    Use global theme
                                </MudSelectItem>

                                <MudSelectItem T="AppTheme?"
                                               Value="@((AppTheme?)AppTheme.Carbon)">
                                    Carbon
                                </MudSelectItem>

                                <MudSelectItem T="AppTheme?"
                                               Value="@((AppTheme?)AppTheme.Slate)">
                                    Slate
                                </MudSelectItem>

                            </MudSelect>

                        </MudStack>

                    </MudPaper>
                </MudItem>

                <MudItem xs="12">
                    <MudPaper Class="pa-6" Elevation="1">
                        <MudStack Spacing="4">
                            <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Outlined.Key"
                                         Size="Size.Small"
                                         Color="Color.Primary"/>
                                <MudText Typo="Typo.h5">API access</MudText>
                            </MudStack>

                            @if (_apiKey is null)
                            {
                                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                                    An API key has not been generated for your account.
                                </MudAlert>
                            }
                            else
                            {
                                <MudTextField T="string"
                                              Value="@_apiKey"
                                              Label="API key"
                                              Variant="Variant.Outlined"
                                              ReadOnly
                                              FullWidth
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Outlined.Key"
                                              HelperText="Send this value in the X-Api-Key request header."
                                              Style="font-family: monospace;"/>
                            }
                        </MudStack>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12">
                    <MudStack Row
                              Wrap="Wrap.Wrap"
                              Justify="Justify.FlexEnd"
                              Spacing="2">

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Outlined.Save"
                                   Disabled="_saving"
                                   OnClick="@SaveAsync">
                            Save changes
                        </MudButton>

                    </MudStack>
                </MudItem>

            </MudGrid>

        </MudForm>

    </MudStack>

</MudContainer>

@code
{
    private MudForm _form = null!;
    private Web.Settings.UserSettings _settings = new();
    private bool _saving;
    private string? _apiKey;

    protected override async Task OnInitializedAsync()
    {
        _settings = await UserSettingsProvider.GetAsync();
        _apiKey = await UserApiKeyService.GetAsync();
    }

    private async Task SaveAsync()
    {
        if (!_form.IsValid)
        {
            return;
        }

        try
        {
            _saving = true;
            await UserSettingsProvider.UpdateAsync(_settings);
        }
        finally
        {
            _saving = false;
        }
    }
}
