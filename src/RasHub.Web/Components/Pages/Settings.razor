@page "/Settings"
@using RasHub.Web.Infrastructure.Authorization
@attribute [Authorize(Policy = AppPolicies.ManageGlobalSettings)]

<AppPageTitle Title="Settings"/>

<AppPageShell Width="AppPageWidth.Standard"
              Title="Settings"
              Subtitle="Configure application settings and user access"
              Icon="@Icons.Material.Filled.Settings">
    <MudStack Spacing="4">
        <ApplicationSettingsPanel/>
        <UserAdministrationPanel/>
    </MudStack>
</AppPageShell>
