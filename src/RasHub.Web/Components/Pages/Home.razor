@page "/"
@using Microsoft.Extensions.Options
@using RasHub.Infrastructure.Database.Queries
@using RasHub.Web.Infrastructure.Diagnostics
@using RasHub.Web.Infrastructure.RasGates
@implements IAsyncDisposable
@inject ApplicationDiagnostics Diagnostics
@inject RasGateQueries RasGateQueries
@inject IOptions<RasGateMonitoringOptions> RasGateMonitoringOptions
@inject TimeProvider TimeProvider
@inject ILogger<Home> Logger

<AppPageTitle Title="Home"/>

<AppPageShell Width="AppPageWidth.Wide"
              Title="Home"
              Subtitle="Administration and monitoring"
              Icon="@Icons.Material.Filled.Home"
              Class="home-page">
    <MudStack Spacing="6">
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="6" lg="3">
                <MetricCard Title="Uptime"
                            Value="@FormatDuration(Uptime)"
                            Icon="@Icons.Material.Filled.Schedule"
                            Color="Color.Info"
                            TopAccent/>
            </MudItem>
            <MudItem xs="12" sm="6" lg="3">
                <MetricCard Title="Online RasGates"
                            Value="@_onlineRasGateCount.ToString("N0")"
                            Icon="@Icons.Material.Filled.SettingsEthernet"
                            Color="Color.Info"
                            ValueHref="/ras-gates"
                            ValueAriaLabel="View RasGates"
                            TopAccent/>
            </MudItem>
            <MudItem xs="12" sm="6" lg="3">
                <MetricCard Title="Warnings"
                            Value="@Diagnostics.WarningCount.ToString("N0")"
                            Icon="@Icons.Material.Filled.Warning"
                            Color="Color.Warning"
                            ValueHref="/health-events?level=warnings"
                            ValueAriaLabel="View all application warnings"
                            TopAccent
                            TopAccentColor="Color.Warning"/>
            </MudItem>
            <MudItem xs="12" sm="6" lg="3">
                <MetricCard Title="Errors"
                            Value="@Diagnostics.ErrorCount.ToString("N0")"
                            Icon="@Icons.Material.Filled.Error"
                            Color="Color.Error"
                            ValueHref="/health-events?level=errors"
                            ValueAriaLabel="View all application errors"
                            TopAccent
                            TopAccentColor="Color.Error"/>
            </MudItem>
        </MudGrid>

        <MudPaper Class="pa-4 health-panel" Elevation="1">
            <div class="health-header">
                <div>
                    <MudText Typo="Typo.h6">Health history</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Warning and error events during the last 24 hours
                    </MudText>
                </div>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Updated @_now.ToLocalTime().ToString("HH:mm:ss")
                </MudText>
            </div>

            <div class="health-timeline-scroll">
                <div class="health-timeline" role="list" aria-label="Application health during the last 24 hours">
                    @foreach (var hour in _healthHours)
                    {
                        <MudTooltip Text="@FormatHourTooltip(hour)" Placement="Placement.Top" Arrow="true">
                            <a class="@GetHourClass(hour)"
                               href="@GetHourEventsUrl(hour)"
                               role="listitem"
                               aria-label="@GetHourLinkLabel(hour)">
                                <span class="health-hour-time">
                                    @hour.StartedAt.ToLocalTime().ToString("HH")
                                </span>
                                <span class="health-hour-counts">
                                    @if (!hour.HasData)
                                    {
                                        <span class="health-hour-empty">—</span>
                                    }
                                    else if (hour.WarningCount == 0 && hour.ErrorCount == 0)
                                    {
                                        <span class="health-hour-ok">OK</span>
                                    }
                                    else
                                    {
                                        @if (hour.WarningCount > 0)
                                        {
                                            <span>W @FormatCount(hour.WarningCount)</span>
                                        }

                                        @if (hour.ErrorCount > 0)
                                        {
                                            <span>E @FormatCount(hour.ErrorCount)</span>
                                        }
                                    }
                                </span>
                            </a>
                        </MudTooltip>
                    }
                </div>
            </div>

            <div class="health-legend" aria-label="Health history legend">
                <span><i class="health-legend-swatch health-legend-swatch--healthy"></i>Healthy</span>
                <span><i class="health-legend-swatch health-legend-swatch--warning"></i>Warnings</span>
                <span><i class="health-legend-swatch health-legend-swatch--error"></i>Errors</span>
                <span><i class="health-legend-swatch"></i>No data</span>
            </div>
        </MudPaper>
    </MudStack>
</AppPageShell>

@code {
    private readonly CancellationTokenSource _disposeToken = new();
    private static readonly TimeSpan RasGateCountRefreshInterval = TimeSpan.FromSeconds(10);
    private Task _pollTask = Task.CompletedTask;
    private IReadOnlyList<ApplicationHealthHour> _healthHours = [];
    private DateTimeOffset _nextRasGateCountRefreshAt;
    private DateTimeOffset _now;
    private int _onlineRasGateCount;

    private TimeSpan Uptime => _now - Diagnostics.StartedAt;
    private RasGateMonitoringOptions MonitoringOptions => RasGateMonitoringOptions.Value;

    protected override async Task OnInitializedAsync()
    {
        RefreshDiagnostics();
        await RefreshRasGateCountAsync();
        _pollTask = PollAsync();
    }

    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1), TimeProvider);

        try
        {
            while (await timer.WaitForNextTickAsync(_disposeToken.Token))
                try
                {
                    await InvokeAsync(async () =>
                    {
                        RefreshDiagnostics();

                        if (_now >= _nextRasGateCountRefreshAt)
                            await RefreshRasGateCountAsync();

                        StateHasChanged();
                    });
                }
                catch (Exception exception) when (!_disposeToken.IsCancellationRequested)
                {
                    Logger.LogError(
                        exception,
                        "Unable to refresh the home dashboard");
                }
        }
        catch (OperationCanceledException) when (_disposeToken.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Home dashboard polling stopped unexpectedly");
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposeToken.Cancel();

        try
        {
            await _pollTask;
        }
        finally
        {
            _disposeToken.Dispose();
        }
    }

    private void RefreshDiagnostics()
    {
        _now = TimeProvider.GetUtcNow();
        _healthHours = Diagnostics.GetHourlyHealth(_now);
    }

    private async Task RefreshRasGateCountAsync()
    {
        var onlineSince = (_now - MonitoringOptions.OnlineThreshold).UtcDateTime;
        var summary = await RasGateQueries.GetHealthSummaryAsync(
            onlineSince,
            _disposeToken.Token);

        _onlineRasGateCount = summary.OnlineCount;
        _nextRasGateCountRefreshAt = _now + RasGateCountRefreshInterval;
    }

    private string GetHourClass(ApplicationHealthHour hour)
    {
        var stateClass = !hour.HasData
            ? "health-hour--no-data"
            : hour.ErrorCount > 0
                ? "health-hour--error"
                : hour.WarningCount > 0
                    ? "health-hour--warning"
                    : "health-hour--healthy";
        var currentHourClass = hour.StartedAt == GetHourStart(_now)
            ? " health-hour--current"
            : string.Empty;

        return $"health-hour {stateClass}{currentHourClass}";
    }

    private static string FormatHourTooltip(ApplicationHealthHour hour)
    {
        var start = hour.StartedAt.ToLocalTime();
        var end = start.AddHours(1);
        var state = !hour.HasData
            ? "No data"
            : hour.ErrorCount > 0
                ? "Errors detected"
                : hour.WarningCount > 0
                    ? "Warnings detected"
                    : "Healthy";

        return $"{start:dd MMM, HH:mm}–{end:HH:mm} · {state} · " +
               $"Warnings: {hour.WarningCount:N0} · Errors: {hour.ErrorCount:N0}";
    }

    private static string GetHourEventsUrl(ApplicationHealthHour hour)
    {
        return $"/health-events?from={hour.StartedAt.ToUnixTimeSeconds()}&" +
               $"to={hour.StartedAt.AddHours(1).ToUnixTimeSeconds()}";
    }

    private static string GetHourLinkLabel(ApplicationHealthHour hour)
    {
        return $"View application events for {hour.StartedAt.ToLocalTime():dd MMM, HH:mm}";
    }

    private static string FormatCount(long count)
    {
        return count > 999 ? "999+" : count.ToString();
    }

    private static DateTimeOffset GetHourStart(DateTimeOffset value)
    {
        var utc = value.UtcDateTime;
        return new DateTimeOffset(
            utc.Year,
            utc.Month,
            utc.Day,
            utc.Hour,
            0,
            0,
            TimeSpan.Zero);
    }

    private static string FormatDuration(TimeSpan value)
    {
        var duration = value < TimeSpan.Zero ? TimeSpan.Zero : value;

        return duration.TotalDays >= 1
            ? $"{(int)duration.TotalDays}d {duration.Hours:00}h"
            : duration.TotalHours >= 1
                ? $"{(int)duration.TotalHours:00}h {duration.Minutes:00}m"
                : $"{duration.Minutes:00}m {duration.Seconds:00}s";
    }

}
