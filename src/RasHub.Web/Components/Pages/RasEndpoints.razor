@page "/ras-endpoints"
@attribute [Authorize(Policy = AppPolicies.ManageRasEndpoints)]
@using RasHub.Infrastructure.Database.Queries
@using RasHub.Web.Infrastructure.Authorization
@using RasHub.Web.Infrastructure.RasEndpoints
@implements IDisposable
@inject RasEndpointAdministrationService AdministrationService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<RasEndpoints> Logger

<AppPageTitle Title="RAS endpoints"/>

<AppPageShell Width="AppPageWidth.Wide"
              Title="RAS endpoints"
              Subtitle="Administration servers assigned to RasGate execution nodes"
              Icon="@Icons.Material.Filled.Link">
    <HeaderActions>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Outlined.Add"
                   Disabled="@(_busyEndpointId is not null || _gateOptions.Count == 0)"
                   OnClick="AddAsync">
            Add
        </MudButton>
    </HeaderActions>
    <ChildContent>
        <MudPaper Class="pa-4" Elevation="1">
            <div class="ras-endpoints-table-toolbar">
                <MudSwitch T="bool"
                           Value="@_showDeleted"
                           ValueChanged="ShowDeletedChangedAsync"
                           Label="Show deleted"
                           Color="Color.Primary"
                           Disabled="@(_loading || _busyEndpointId is not null)"/>

                <MudIconButton Icon="@Icons.Material.Outlined.Refresh"
                               Size="Size.Small"
                               Disabled="@_loading"
                               OnClick="LoadAsync"
                               aria-label="Reload RAS endpoints"/>
            </div>

            @if (_loading && _items.Count == 0)
            {
                <MudProgressLinear Indeterminate Color="Color.Primary"/>
            }

            <MudTable T="RasEndpointAdministrationItem"
                      Items="@_items"
                      Hover
                      Elevation="0"
                      Breakpoint="Breakpoint.Md"
                      RowsPerPage="@int.MaxValue">
                <HeaderContent>
                    <MudTh>Status</MudTh>
                    <MudTh>RAS endpoint</MudTh>
                    <MudTh>Address</MudTh>
                    <MudTh>RasGate</MudTh>
                    <MudTh>Changed</MudTh>
                    <MudTh Class="text-right">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Status">
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Variant="Variant.Outlined"
                                 Icon="@StatusIcon(context)"
                                 Color="@StatusColor(context)">
                            @StatusLabel(context)
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="RAS endpoint">
                        <MudText Typo="Typo.body2">@context.Name</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @context.Id.ToString()[..8]
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="Address">
                        <MudText Typo="Typo.body2">@FormatAddress(context)</MudText>
                    </MudTd>
                    <MudTd DataLabel="RasGate">
                        <MudText Typo="Typo.body2">@context.RasGateName</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @FormatGateEndpoint(context)
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="Changed">
                        <MudText Typo="Typo.body2">
                            @FormatTime(context.IsDeleted ? context.DeletedAt : context.UpdatedAt)
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @(context.IsDeleted ? "Deleted" : "Updated")
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="Actions" Class="text-right">
                        @if (_busyEndpointId == context.Id)
                        {
                            <MudProgressCircular Indeterminate Size="Size.Small" Color="Color.Primary"/>
                        }
                        else
                        {
                            <MudMenu Icon="@Icons.Material.Outlined.MoreVert"
                                     Size="Size.Small"
                                     Dense
                                     AnchorOrigin="Origin.BottomRight"
                                     TransformOrigin="Origin.TopRight"
                                     Disabled="@(_busyEndpointId is not null)"
                                     AriaLabel="@($"Actions for {context.Name}")">
                                @if (context.IsDeleted)
                                {
                                    <MudMenuItem Icon="@Icons.Material.Outlined.RestoreFromTrash"
                                                 IconColor="Color.Success"
                                                 OnClick="@(() => RestoreAsync(context))">
                                        Restore
                                    </MudMenuItem>
                                }
                                else
                                {
                                    <MudMenuItem Icon="@Icons.Material.Outlined.Edit"
                                                 OnClick="@(() => EditAsync(context))">
                                        Edit endpoint
                                    </MudMenuItem>
                                    <MudDivider/>
                                    <MudMenuItem Icon="@(context.IsActive
                                                           ? Icons.Material.Outlined.PauseCircle
                                                           : Icons.Material.Outlined.PlayCircle)"
                                                 IconColor="@(context.IsActive ? Color.Warning : Color.Success)"
                                                 OnClick="@(() => SetActiveAsync(context, !context.IsActive))">
                                        @(context.IsActive ? "Deactivate" : "Activate")
                                    </MudMenuItem>
                                    <MudMenuItem Icon="@Icons.Material.Outlined.DeleteOutline"
                                                 IconColor="Color.Error"
                                                 OnClick="@(() => DeleteAsync(context))">
                                        Delete
                                    </MudMenuItem>
                                }
                            </MudMenu>
                        }
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-8">
                        <MudIcon Icon="@Icons.Material.Filled.Link"
                                 Color="Color.Secondary"
                                 Size="Size.Large"/>
                        <MudText Typo="Typo.h6">No RAS endpoints configured</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Register a RasGate, then add an administration server assigned to it.
                        </MudText>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Outlined.Add"
                                   Disabled="@(_gateOptions.Count == 0)"
                                   OnClick="AddAsync">
                            Add
                        </MudButton>
                    </MudStack>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </ChildContent>
</AppPageShell>

@code {

    private static readonly DialogOptions EditorDialogOptions = new()
    {
        MaxWidth = MaxWidth.Small,
        FullWidth = true,
        CloseButton = true,
        BackdropClick = false
    };

    private readonly CancellationTokenSource _disposeToken = new();
    private readonly SemaphoreSlim _operationLock = new(1, 1);
    private IReadOnlyList<RasEndpointAdministrationItem> _items = [];
    private IReadOnlyList<RasEndpointGateOption> _gateOptions = [];
    private Guid? _busyEndpointId;
    private bool _loading;
    private bool _showDeleted;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (!await _operationLock.WaitAsync(0, _disposeToken.Token))
            return;

        try
        {
            await LoadCoreAsync();
        }
        catch (OperationCanceledException) when (_disposeToken.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unable to load RAS endpoint administration data");
            Snackbar.Add("Unable to load RAS endpoints.", Severity.Error);
        }
        finally
        {
            _loading = false;
            _operationLock.Release();
        }
    }

    private async Task LoadCoreAsync()
    {
        _loading = true;
        _items = await AdministrationService.GetItemsAsync(
            _showDeleted,
            _disposeToken.Token);
        _gateOptions = await AdministrationService.GetGateOptionsAsync(
            _disposeToken.Token);
    }

    private async Task AddAsync()
    {
        var values = await ShowEditorAsync(null);
        if (values is null)
            return;

        await ExecuteAsync(
            null,
            cancellationToken => AdministrationService.CreateAsync(
                values,
                cancellationToken),
            "RAS endpoint was added.",
            "Unable to add the RAS endpoint.");
    }

    private async Task EditAsync(RasEndpointAdministrationItem item)
    {
        var values = await ShowEditorAsync(item);
        if (values is null)
            return;

        await ExecuteAsync(
            item.Id,
            cancellationToken => AdministrationService.UpdateAsync(
                item.Id,
                item.ConfigurationRevision,
                values,
                cancellationToken),
            $"{item.Name} was updated.",
            "Unable to update the RAS endpoint.");
    }

    private Task SetActiveAsync(
        RasEndpointAdministrationItem item,
        bool isActive)
    {
        var values = new RasEndpointEditorValues(
            item.Name,
            item.RasGateId,
            item.Host,
            item.Port,
            isActive);

        return ExecuteAsync(
            item.Id,
            cancellationToken => AdministrationService.UpdateAsync(
                item.Id,
                item.ConfigurationRevision,
                values,
                cancellationToken),
            isActive
                ? $"{item.Name} was activated."
                : $"{item.Name} was deactivated.",
            "Unable to change the RAS endpoint activity.");
    }

    private Task RestoreAsync(RasEndpointAdministrationItem item)
    {
        return ExecuteAsync(
            item.Id,
            cancellationToken => AdministrationService.RestoreAsync(
                item.Id,
                cancellationToken),
            $"{item.Name} was restored.",
            "Unable to restore the RAS endpoint.");
    }

    private async Task ShowDeletedChangedAsync(bool value)
    {
        _showDeleted = value;
        await LoadAsync();
    }

    private async Task DeleteAsync(RasEndpointAdministrationItem item)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete RAS endpoint?",
            $"Delete {item.Name}? The endpoint will disappear from regular queries, " +
            "but its record is retained through soft deletion.",
            "Delete",
            cancelText: "Cancel");

        if (confirmed != true)
            return;

        await ExecuteAsync(
            item.Id,
            cancellationToken => AdministrationService.DeleteAsync(
                item.Id,
                cancellationToken),
            $"{item.Name} was deleted.",
            "Unable to delete the RAS endpoint.");
    }

    private async Task<RasEndpointEditorValues?> ShowEditorAsync(
        RasEndpointAdministrationItem? item)
    {
        var parameters = new DialogParameters<RasEndpointEditorDialog>
        {
            { dialog => dialog.GateOptions, _gateOptions }
        };
        if (item is not null)
            parameters.Add(dialog => dialog.Endpoint, item);

        var dialog = await DialogService.ShowAsync<RasEndpointEditorDialog>(
            item is null ? "Add RAS endpoint" : $"Edit {item.Name}",
            parameters,
            EditorDialogOptions);
        var result = await dialog.Result;

        return result is
            { Canceled: false, Data: RasEndpointEditorValues values }
            ? values
            : null;
    }

    private async Task ExecuteAsync(
        Guid? endpointId,
        Func<CancellationToken, Task<RasEndpointAdministrationResult>> operation,
        string successMessage,
        string fallbackError)
    {
        var lockAcquired = false;

        try
        {
            await _operationLock.WaitAsync(_disposeToken.Token);
            lockAcquired = true;
            _busyEndpointId = endpointId ?? Guid.Empty;
            var result = await operation(_disposeToken.Token);
            Snackbar.Add(
                result.Succeeded ? successMessage : result.Error ?? fallbackError,
                result.Succeeded ? Severity.Success : Severity.Error);

            await LoadCoreAsync();
        }
        catch (OperationCanceledException) when (_disposeToken.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "RAS endpoint administration operation failed for {RasEndpointId}",
                endpointId);
            Snackbar.Add(fallbackError, Severity.Error);
        }
        finally
        {
            _busyEndpointId = null;
            _loading = false;

            if (lockAcquired)
                _operationLock.Release();
        }
    }

    private static string StatusLabel(RasEndpointAdministrationItem item)
    {
        if (item.IsDeleted)
            return "Deleted";
        if (!item.IsActive)
            return "Inactive";
        if (item.RasGateIsDeleted || !item.RasGateIsActive)
            return "Gate unavailable";

        return "Active";
    }

    private static Color StatusColor(RasEndpointAdministrationItem item)
    {
        if (item.IsDeleted)
            return Color.Error;
        if (!item.IsActive)
            return Color.Default;
        if (item.RasGateIsDeleted || !item.RasGateIsActive)
            return Color.Warning;

        return Color.Success;
    }

    private static string StatusIcon(RasEndpointAdministrationItem item)
    {
        if (item.IsDeleted)
            return Icons.Material.Outlined.DeleteOutline;
        if (!item.IsActive)
            return Icons.Material.Outlined.PauseCircle;
        if (item.RasGateIsDeleted || !item.RasGateIsActive)
            return Icons.Material.Outlined.WarningAmber;

        return Icons.Material.Outlined.CheckCircle;
    }

    private static string FormatAddress(RasEndpointAdministrationItem item)
    {
        return item.Host.Contains(':', StringComparison.Ordinal)
            ? $"[{item.Host}]:{item.Port}"
            : $"{item.Host}:{item.Port}";
    }

    private static string FormatGateEndpoint(
        RasEndpointAdministrationItem item)
    {
        if (!Uri.TryCreate(item.RasGateUrl, UriKind.Absolute, out var address))
            return $"{item.RasGateUrl} · port {item.RasGatePort}";

        return new UriBuilder(address) { Port = item.RasGatePort }
            .Uri
            .ToString()
            .TrimEnd('/');
    }

    private static string FormatTime(DateTime? value)
    {
        return value?.ToLocalTime().ToString("dd MMM, HH:mm:ss") ?? "—";
    }

    public void Dispose()
    {
        _disposeToken.Cancel();
        _disposeToken.Dispose();
    }

}
