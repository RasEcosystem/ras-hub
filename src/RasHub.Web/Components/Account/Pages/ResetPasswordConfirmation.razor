@page "/Account/ResetPasswordConfirmation"
@using Microsoft.AspNetCore.Authorization

@attribute [AllowAnonymous]
@layout LoginLayout

<AppPageTitle Title="Password reset"/>

<MudStack Spacing="4">

    <MudStack Spacing="1"
              AlignItems="AlignItems.Center">

        <MudAvatar Color="Color.Success"
                   Size="Size.Large">

            <MudIcon Icon="@Icons.Material.Outlined.Check"
                     Size="Size.Large"/>

        </MudAvatar>

        <MudText Typo="Typo.h3"
                 Align="Align.Center">
            Password reset
        </MudText>

        <MudText Typo="Typo.body1"
                 Color="Color.Secondary"
                 Align="Align.Center">
            Your password has been updated successfully
        </MudText>

    </MudStack>

    <MudPaper Class="pa-6"
              Elevation="1"
              role="alert">

        <MudStack Spacing="4"
                  AlignItems="AlignItems.Center">

            <MudStack Spacing="1"
                      AlignItems="AlignItems.Center">

                <MudText Typo="Typo.h5"
                         Align="Align.Center">
                    You can now sign in
                </MudText>

                <MudText Typo="Typo.body2"
                         Color="Color.Secondary"
                         Align="Align.Center">
                    Use your new password to access your RasHub account.
                </MudText>

            </MudStack>

            <MudButton Href="Account/Login"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth
                       StartIcon="@Icons.Material.Outlined.Login">
                Go to login
            </MudButton>

        </MudStack>

    </MudPaper>

</MudStack>