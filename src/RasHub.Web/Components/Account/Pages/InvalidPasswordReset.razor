@page "/Account/InvalidPasswordReset"
@using Microsoft.AspNetCore.Authorization

@attribute [AllowAnonymous]
@layout LoginLayout

<AppPageTitle Title="Invalid password reset"/>

<MudStack Spacing="4">

    <MudStack Spacing="1"
              AlignItems="AlignItems.Center">

        <MudAvatar Color="Color.Error"
                   Size="Size.Large">

            <MudIcon Icon="@Icons.Material.Outlined.LinkOff"
                     Size="Size.Large"/>

        </MudAvatar>

        <MudText Typo="Typo.h3"
                 Align="Align.Center">
            Invalid reset link
        </MudText>

        <MudText Typo="Typo.body1"
                 Color="Color.Secondary"
                 Align="Align.Center">
            This password reset request can’t be used
        </MudText>

    </MudStack>

    <MudPaper Class="pa-6"
              Elevation="1"
              role="alert">

        <MudStack Spacing="4"
                  AlignItems="AlignItems.Center">

            <MudAlert Severity="Severity.Error"
                      Variant="Variant.Outlined"
                      Dense="true">
                The password reset link is invalid or has expired.
            </MudAlert>

            <MudText Typo="Typo.body2"
                     Color="Color.Secondary"
                     Align="Align.Center">
                Request a new password reset link and try again.
            </MudText>

            <MudButton Href="Account/ForgotPassword"
                       Variant="Variant.Outlined"
                       Color="Color.Primary"
                       FullWidth="true"
                       StartIcon="@Icons.Material.Outlined.Refresh">
                Request a new reset link
            </MudButton>

            <MudButton Href="Account/Login"
                       Variant="Variant.Text"
                       Color="Color.Primary"
                       FullWidth="true">
                Return to login
            </MudButton>

        </MudStack>

    </MudPaper>

</MudStack>
