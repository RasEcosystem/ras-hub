@page "/Account/ConfirmEmailChange"
@using System.Text
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.WebUtilities
@using RasHub.Web.Data

@attribute [AllowAnonymous]
@layout LoginLayout

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

<AppPageTitle Title="Confirm email change"/>

<MudStack Spacing="4">

    <MudStack Spacing="1"
              AlignItems="AlignItems.Center">

        <MudAvatar Color="@ResultColor"
                   Size="Size.Large">

            <MudIcon Icon="@ResultIcon"
                     Size="Size.Large"/>

        </MudAvatar>

        <MudText Typo="Typo.h3"
                 Align="Align.Center">
            @ResultTitle
        </MudText>

        <MudText Typo="Typo.body1"
                 Color="Color.Secondary"
                 Align="Align.Center">
            @ResultSubtitle
        </MudText>

    </MudStack>

    <StatusMessage Message="@message"/>

    <MudPaper Class="pa-6"
              Elevation="1"
              role="alert">

        <MudStack Spacing="4"
                  AlignItems="AlignItems.Center">

            @if (IsSuccessful)
            {
                <MudAlert Severity="Severity.Success"
                          Variant="Variant.Outlined"
                          Dense="true">
                    Your email address has been updated successfully.
                </MudAlert>

                <MudText Typo="Typo.body2"
                         Color="Color.Secondary"
                         Align="Align.Center">
                    You can continue using RasHub with your new email address.
                </MudText>

                <MudButton Href="/"
                           Variant="Variant.Outlined"
                           Color="Color.Primary"
                           FullWidth="true"
                           StartIcon="@Icons.Material.Outlined.Home">
                    Return to application
                </MudButton>
            }
            else
            {
                <MudAlert Severity="Severity.Error"
                          Variant="Variant.Outlined"
                          Dense="true">
                    The email address could not be changed.
                </MudAlert>

                <MudText Typo="Typo.body2"
                         Color="Color.Secondary"
                         Align="Align.Center">
                    The confirmation link may be invalid, expired, or associated with another account.
                </MudText>

                <MudButton Href="Account/Login"
                           Variant="Variant.Outlined"
                           Color="Color.Primary"
                           FullWidth="true"
                           StartIcon="@Icons.Material.Outlined.Login">
                    Return to login
                </MudButton>
            }

        </MudStack>

    </MudPaper>

</MudStack>

@code {
    private string? message;

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery] private string? UserId { get; set; }

    [SupplyParameterFromQuery] private string? Email { get; set; }

    [SupplyParameterFromQuery] private string? Code { get; set; }

    private bool IsSuccessful =>
        message == "Thank you for confirming your email change.";

    private Color ResultColor =>
        IsSuccessful
            ? Color.Success
            : Color.Error;

    private string ResultIcon =>
        IsSuccessful
            ? Icons.Material.Outlined.MarkEmailRead
            : Icons.Material.Outlined.MarkEmailUnread;

    private string ResultTitle =>
        IsSuccessful
            ? "Email updated"
            : "Email change failed";

    private string ResultSubtitle =>
        IsSuccessful
            ? "Your new email address has been confirmed"
            : "We could not confirm your email change";

    protected override async Task OnInitializedAsync()
    {
        if (UserId is null ||
            Email is null ||
            Code is null)
        {
            RedirectManager.RedirectToWithStatus(
                "Account/Login",
                "Error: Invalid email change confirmation link.",
                HttpContext);

            return;
        }

        var user =
            await UserManager.FindByIdAsync(UserId);

        if (user is null)
        {
            message =
                $"Unable to find user with Id '{UserId}'";

            return;
        }

        var code =
            Encoding.UTF8.GetString(
                WebEncoders.Base64UrlDecode(Code));

        var result =
            await UserManager.ChangeEmailAsync(
                user,
                Email,
                code);

        if (!result.Succeeded)
        {
            message =
                "Error changing email.";

            return;
        }

        // Email and user name are identical in this application,
        // so both values must be updated.
        var setUserNameResult =
            await UserManager.SetUserNameAsync(
                user,
                Email);

        if (!setUserNameResult.Succeeded)
        {
            message =
                "Error changing user name.";

            return;
        }

        await SignInManager.RefreshSignInAsync(user);

        message =
            "Thank you for confirming your email change.";
    }

}
