@page "/Account/ForgotPasswordConfirmation"
@using Microsoft.AspNetCore.Authorization

@attribute [AllowAnonymous]
@layout LoginLayout

<AppPageTitle Title="Forgot password confirmation"/>

<MudStack Spacing="4">

    <MudStack Spacing="1"
              AlignItems="AlignItems.Center">

        <MudAvatar Color="Color.Primary"
                   Size="Size.Large">

            <MudIcon Icon="@Icons.Material.Outlined.MarkEmailRead"
                     Size="Size.Large"/>

        </MudAvatar>

        <MudText Typo="Typo.h3"
                 Align="Align.Center">
            Check your email
        </MudText>

        <MudText Typo="Typo.body1"
                 Color="Color.Secondary"
                 Align="Align.Center">
            We sent you instructions to reset your password
        </MudText>

    </MudStack>

    <MudPaper Class="pa-6"
              Elevation="1"
              role="alert">

        <MudStack Spacing="4"
                  AlignItems="AlignItems.Center">

            <MudAlert Severity="Severity.Info"
                      Variant="Variant.Outlined"
                      Dense="true">
                Please check your inbox and follow the password reset link.
            </MudAlert>

            <MudText Typo="Typo.body2"
                     Color="Color.Secondary"
                     Align="Align.Center">
                If you don’t see the message, check your spam folder or request a new link.
            </MudText>

            <MudButton Href="Account/Login"
                       Variant="Variant.Outlined"
                       Color="Color.Primary"
                       FullWidth="true"
                       StartIcon="@Icons.Material.Outlined.Login">
                Return to login
            </MudButton>

        </MudStack>

    </MudPaper>

</MudStack>