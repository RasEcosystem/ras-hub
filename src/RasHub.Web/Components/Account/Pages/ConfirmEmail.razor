@page "/Account/ConfirmEmail"
@using System.Text
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.WebUtilities
@using RasHub.Web.Data

@attribute [AllowAnonymous]
@layout LoginLayout

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<AppPageTitle Title="Confirm email"/>

<MudStack Spacing="4">

    <MudStack Spacing="1"
              AlignItems="AlignItems.Center">

        <MudAvatar Color="@ResultColor"
                   Size="Size.Large">

            <MudIcon Icon="@ResultIcon"
                     Size="Size.Large"/>

        </MudAvatar>

        <MudText Typo="Typo.h3"
                 Align="Align.Center">
            @ResultTitle
        </MudText>

        <MudText Typo="Typo.body1"
                 Color="Color.Secondary"
                 Align="Align.Center">
            @ResultSubtitle
        </MudText>

    </MudStack>

    <StatusMessage Message="@statusMessage"/>

    <MudPaper Class="pa-6"
              Elevation="1"
              role="alert">

        <MudStack Spacing="4"
                  AlignItems="AlignItems.Center">

            @if (IsSuccessful)
            {
                <MudAlert Severity="Severity.Success"
                          Variant="Variant.Outlined"
                          Dense="true">
                    Your email address has been confirmed successfully.
                </MudAlert>

                <MudText Typo="Typo.body2"
                         Color="Color.Secondary"
                         Align="Align.Center">
                    Your account is ready. You can now sign in to RasHub.
                </MudText>

                <MudButton Href="Account/Login"
                           Variant="Variant.Outlined"
                           Color="Color.Primary"
                           FullWidth="true"
                           StartIcon="@Icons.Material.Outlined.Login">
                    Go to login
                </MudButton>
            }
            else
            {
                <MudAlert Severity="Severity.Error"
                          Variant="Variant.Outlined"
                          Dense="true">
                    We could not confirm your email address.
                </MudAlert>

                <MudText Typo="Typo.body2"
                         Color="Color.Secondary"
                         Align="Align.Center">
                    The confirmation link may be invalid, expired, or already used.
                </MudText>

                <MudButton Href="Account/ResendEmailConfirmation"
                           Variant="Variant.Outlined"
                           Color="Color.Primary"
                           FullWidth="true"
                           StartIcon="@Icons.Material.Outlined.Refresh">
                    Request a new confirmation link
                </MudButton>

                <MudButton Href="Account/Login"
                           Variant="Variant.Text"
                           Color="Color.Primary"
                           FullWidth="true">
                    Return to login
                </MudButton>
            }

        </MudStack>

    </MudPaper>

</MudStack>

@code {

    private const string SuccessMessage =
        "Thank you for confirming your email.";

    private string? statusMessage;

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery] private string? UserId { get; set; }

    [SupplyParameterFromQuery] private string? Code { get; set; }

    private bool IsSuccessful =>
        statusMessage == SuccessMessage;

    private Color ResultColor =>
        IsSuccessful
            ? Color.Success
            : Color.Error;

    private string ResultIcon =>
        IsSuccessful
            ? Icons.Material.Outlined.MarkEmailRead
            : Icons.Material.Outlined.MarkEmailUnread;

    private string ResultTitle =>
        IsSuccessful
            ? "Email confirmed"
            : "Confirmation failed";

    private string ResultSubtitle =>
        IsSuccessful
            ? "Your account is ready to use"
            : "We could not verify your email address";

    protected override async Task OnInitializedAsync()
    {
        if (UserId is null || Code is null)
        {
            RedirectManager.RedirectTo("");
            return;
        }

        var user =
            await UserManager.FindByIdAsync(UserId);

        if (user is null)
        {
            HttpContext.Response.StatusCode =
                StatusCodes.Status404NotFound;

            statusMessage =
                $"Error loading user with ID {UserId}";

            return;
        }

        var code =
            Encoding.UTF8.GetString(
                WebEncoders.Base64UrlDecode(Code));

        var result =
            await UserManager.ConfirmEmailAsync(
                user,
                code);

        statusMessage =
            result.Succeeded
                ? SuccessMessage
                : "Error confirming your email.";
    }

}
