@page "/Account/AccessDenied"
@using Microsoft.AspNetCore.Authorization

@attribute [AllowAnonymous]
@layout LoginLayout

<AppPageTitle Title="Access denied"/>

<MudStack Spacing="4">

    <MudStack Spacing="1"
              AlignItems="AlignItems.Center">

        <MudAvatar Color="Color.Error"
                   Size="Size.Large">

            <MudIcon Icon="@Icons.Material.Outlined.Block"
                     Size="Size.Large"/>

        </MudAvatar>

        <MudText Typo="Typo.h3"
                 Align="Align.Center">
            Access denied
        </MudText>

        <MudText Typo="Typo.body1"
                 Color="Color.Secondary"
                 Align="Align.Center">
            You don’t have permission to view this resource
        </MudText>

    </MudStack>

    <MudPaper Class="pa-6"
              Elevation="1"
              role="alert">

        <MudStack Spacing="4"
                  AlignItems="AlignItems.Center">

            <MudAlert Severity="Severity.Error"
                      Variant="Variant.Outlined"
                      Dense="true">
                Your account does not have the required permissions.
            </MudAlert>

            <MudText Typo="Typo.body2"
                     Color="Color.Secondary"
                     Align="Align.Center">
                Return to the application or sign in with another account.
            </MudText>

            <MudButton Href="/"
                       Variant="Variant.Outlined"
                       Color="Color.Primary"
                       FullWidth="true"
                       StartIcon="@Icons.Material.Outlined.Home">
                Return to application
            </MudButton>

            <MudButton Href="Account/Login"
                       Variant="Variant.Text"
                       Color="Color.Primary"
                       FullWidth="true"
                       StartIcon="@Icons.Material.Outlined.Login">
                Sign in with another account
            </MudButton>

        </MudStack>

    </MudPaper>

</MudStack>
