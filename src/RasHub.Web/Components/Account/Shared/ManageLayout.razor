@inherits LayoutComponentBase
@layout AccountLayout

<MudStack Spacing="6">

    <MudStack Spacing="1">

        <div class="account-security-heading">
            <MudStack Row
                      AlignItems="AlignItems.Center"
                      Spacing="2">

                <MudIcon Icon="@Icons.Material.Outlined.Security"
                         Size="Size.Large"
                         Color="Color.Primary"/>

                <MudText Typo="Typo.h3" HtmlTag="h1">
                    Account security
                </MudText>

            </MudStack>
        </div>

        <MudText Typo="Typo.subtitle1"
                 Color="Color.Secondary">
            Change your password and manage two-factor authentication
        </MudText>

    </MudStack>

    <MudDivider/>

    <MudGrid Spacing="4">

        <MudItem xs="12"
                 md="3">

            <MudPaper Class="pa-4"
                      Elevation="1">

                <MudStack Spacing="3">

                    <MudStack Spacing="1">

                        <MudText Typo="Typo.h6">
                            Security settings
                        </MudText>

                        <MudText Typo="Typo.body2"
                                 Color="Color.Secondary">
                            Select a security section.
                        </MudText>

                    </MudStack>

                    <MudDivider/>

                    <ManageNavMenu/>

                </MudStack>

            </MudPaper>

        </MudItem>

        <MudItem xs="12"
                 md="9">

            <MudPaper Class="pa-6"
                      Elevation="1">

                @Body

            </MudPaper>

        </MudItem>

    </MudGrid>

</MudStack>
