@using Microsoft.AspNetCore.Antiforgery
@inject IServiceProvider Services

<MudButton ButtonType="ButtonType.Submit"
           Variant="Variant.Outlined"
           Color="Color.Primary"
           StartIcon="@Icons.Material.Outlined.Fingerprint"
           @attributes="AdditionalAttributes"
           name="__passkeySubmit">

    @ChildContent

</MudButton>

<passkey-submit
    operation="@Operation"
    name="@Name"
    email-name="@EmailName"
    request-token-name="@_tokens?.HeaderName"
    request-token-value="@_tokens?.RequestToken">
</passkey-submit>

@code {
    private AntiforgeryTokenSet? _tokens;

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    [Parameter] [EditorRequired] public PasskeyOperation Operation { get; set; }

    [Parameter] [EditorRequired] public string Name { get; set; } = default!;

    [Parameter] public string? EmailName { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    protected override void OnInitialized()
    {
        _tokens = Services
            .GetService<IAntiforgery>()
            ?.GetTokens(HttpContext);
    }

}