RASHUB_IMAGE=rashub:latest
RASHUB_BIND_ADDRESS=127.0.0.1
RASHUB_PORT=8080
# Dedicated Compose network used to give the host TLS proxy a stable source IP.
# If the subnet overlaps another host network, choose another private /24 and
# keep the gateway inside it.
RASHUB_DOCKER_SUBNET=172.31.250.0/24
RASHUB_DOCKER_GATEWAY=172.31.250.1
RASHUB_BOOTSTRAP_ADMIN_EMAIL=rashub@rashub
# setup.sh replaces this with the numeric GID of the secret-reading group.
RASHUB_SECRET_GID=1654
RASHUB_BOOTSTRAP_ADMIN_PASSWORD_FILE=/opt/rashub/secrets/bootstrap-admin-password
RASHUB_DATA_PROTECTION_CERTIFICATE_PATH=/opt/rashub/secrets/data-protection.pfx
RASHUB_DATA_PROTECTION_CERTIFICATE_PASSWORD_FILE=/opt/rashub/secrets/data-protection-password
# Optional override; the compose default exports metrics to its Seq service.
RASHUB_OTLP_METRICS_ENDPOINT=http://seq:5341/ingest/otlp/v1/metrics

SEQ_BIND_ADDRESS=127.0.0.1
SEQ_PORT=5341
SEQ_PUBLIC_URL=http://127.0.0.1:5341/
SEQ_ADMIN_USERNAME=admin
SEQ_ADMIN_PASSWORD_HASH=replace-with-seq-password-hash

POSTGRES_DB=rashub
POSTGRES_USER=rashub
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
